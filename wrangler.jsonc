// Cloudflare Workers の静的アセット配信で公開する（サーバー側のコードは使わない）。
// デプロイ: npm run deploy
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "japantravelaid",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
