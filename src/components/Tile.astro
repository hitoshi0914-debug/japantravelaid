---
// TOP のタイル1枚。色付きの丸にアイコン（絵文字は使わない）。色は tone: 医療は赤系、日常は青系、救急は濃い赤。
import type { Tile } from '../data/categories';
import { Icon } from './Icon';
import { tr, type Lang } from '../i18n/locales';

interface Props {
  tile: Tile;
  lang: Lang;
}
const { tile, lang } = Astro.props;
// そのツールにこの言語のページがなければ英語版へ。
const hrefLang = !tile.langs || tile.langs.includes(lang) ? lang : 'en';
---

<a class:list={['tile', `tile--${tile.tone ?? 'medical'}`]} href={`/${hrefLang}/${tile.path}`} data-ga="tile_click" data-ga-params={JSON.stringify({ tile: tile.id })}>
  <span class="tile-pict"><Icon name={tile.icon} size={30} strokeWidth={2} /></span>
  <span class="tile-text">
    <span class="tile-label">{tr(tile.label, lang)}</span>
    {lang !== 'ja' && <span class="tile-ja" lang="ja">{tile.label.ja}</span>}
  </span>
</a>

<style>
  .tile {
    --tone: var(--medical);
    --tone-soft: var(--medical-soft);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 148px;
    padding: 14px 8px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 4px solid var(--tone);
    color: var(--text);
    text-align: center;
    text-decoration: none;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    transition: transform 0.08s;
  }
  .tile:active { transform: scale(0.97); }
  .tile--daily { --tone: var(--daily); --tone-soft: var(--daily-soft); }
  .tile--emergency { --tone: var(--danger); --tone-soft: var(--danger-soft); background: var(--danger-soft); border-color: var(--danger); }
  .tile-pict { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--tone-soft); color: var(--tone); flex: none; }
  .tile--emergency .tile-pict { background: var(--danger); color: #fff; }
  .tile-text { display: flex; flex-direction: column; gap: 2px; }
  .tile-label { font-weight: 800; font-size: 1rem; line-height: 1.2; }
  .tile-ja { font-size: 0.72rem; color: var(--muted); }
  /* 奇数個のとき最後の1枚（救急など）は横長にする */
  :global(.tile-grid) > .tile:last-child:nth-child(odd), :global(.tools) > .tile:last-child:nth-child(odd) { grid-column: 1 / -1; flex-direction: row; justify-content: flex-start; min-height: 88px; padding: 12px 16px; text-align: left; gap: 14px; }
</style>
