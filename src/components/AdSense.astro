---
// Google AdSense（src/site.config.ts に adsensePublisherId を書いたときだけ出力する）。
// 審査用の確認コードと、合格後の自動広告を兼ねる。広告の位置・量は AdSense の管理画面（自動広告）で決める。
import { adsenseClient } from '../lib/adsense';
---

{adsenseClient && (
  <>
    <meta name="google-adsense-account" content={adsenseClient} />
    {/* 最初の表示を邪魔しないよう、ページの読み込みが終わってから広告のスクリプトを読む（2026-11-18 PageSpeed） */}
    <script is:inline define:vars={{ adsenseClient }}>
      addEventListener('load', function () {
        setTimeout(function () {
          var s = document.createElement('script');
          s.async = true;
          s.crossOrigin = 'anonymous';
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adsenseClient;
          document.head.appendChild(s);
        }, 1500);
      });
    </script>
  </>
)}
