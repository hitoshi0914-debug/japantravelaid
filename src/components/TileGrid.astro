---
// TOP の 2列 × 4行グリッド。ハンバーガーメニューは使わず、ここが唯一のナビゲーション。
import { tiles } from '../data/categories';
import type { Lang } from '../i18n/locales';
import Tile from './Tile.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<nav class="tile-grid" aria-label="Main menu">
  {tiles.map((tile) => <Tile tile={tile} lang={lang} />)}
</nav>

<style>
  .tile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
</style>
