---
// 寄付の「応援する」ボタン（Ko-fi）。site.config の donateUrl が空なら出さない。支払い画面（Ko-fi）は英語だけ。
import { tr, type Lang } from '../i18n/locales';
import { ui } from '../i18n/ui';
import { siteConfig } from '../site.config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const url = siteConfig.donateUrl;
---

{url && (
  <section class="donate">
    <p>{tr(ui.donateNote, lang)}</p>
    <a href={url} target="_blank" rel="noopener" data-ga="donate_click">☕ {tr(ui.donate, lang)}</a>
  </section>
)}

<style>
  .donate { margin-top: 24px; padding: 14px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); text-align: center; }
  .donate p { margin: 0 0 10px; font-size: 0.85rem; color: var(--muted); }
  .donate a { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: var(--tap); padding: 0 18px; border-radius: 999px; background: #ff5e5b; color: #fff; font-weight: 800; text-decoration: none; }
</style>
