---
// 免責表示（全ページ共通・常時表示）。日本語は店員が見ても誤解しないように併記する。
import { tr, type Lang } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<aside class="disclaimer" role="note">
  <p>⚠️ {tr(ui.disclaimerShort, lang)} <a href={`/${lang}/about/`}>{tr(ui.about, lang)}</a></p>
  <p lang="ja">{ui.disclaimerShort.ja}</p>
</aside>

<style>
  .disclaimer {
    margin: 24px 0;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.78rem;
  }
  .disclaimer p { margin: 0 0 4px; }
</style>
