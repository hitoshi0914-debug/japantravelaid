---
// 喫煙所ファインダー: 全画面の地図アプリなので共通レイアウト（Base）は使わず、計測・PWA の部品だけ入れる。
// 地図画面には広告を置かない（ユーザー決定 2026-10-07）。広告は地域ページ（[area].astro）に出す。
// 画面と各言語の文言は SmokingFinder.tsx の中。言語ごとにページがある（/en/・/ja/・/ko/・/zh-tw/・/zh-cn/・/de/・/fr/・/it/・/es/）。
import Analytics from '../../../components/Analytics.astro';
import ConsentBanner from '../../../components/ConsentBanner.astro';
import SmokingFinder from '../../../components/smoking/SmokingFinder';
import { getLocale, langPaths, locales, type Lang } from '../../../i18n/locales';
import { siteConfig } from '../../../site.config';
import '../../../styles/smoking.css';

export const getStaticPaths = () => langPaths();
const lang = Astro.params.lang as Lang;
const url = (code: string) => new URL(`/${code}/smoking/`, Astro.site).href;
const meta = {
  en: { title: 'Smoking Area Finder: public smoking areas near you in Japan', description: 'Find the nearest public smoking areas in Japan on a map. English, 日本語, 한국어, 繁中, 简中, Deutsch, Français, Italiano, Español.' },
  ja: { title: '喫煙所ファインダー｜近くの公衆喫煙所を地図で探す', description: '現在地から近い公衆喫煙所・駅や商業施設の喫煙所を地図で探せます。紙巻きOK・加熱式のみの区別つき。' },
  'zh-tw': { title: '吸菸區搜尋｜在地圖上找到日本附近的公共吸菸區', description: '依目前位置，在地圖上找出日本附近的公共吸菸區及車站、商業設施的吸菸室。標示可吸紙菸或僅限加熱菸。' },
  'zh-cn': { title: '吸烟区查找｜在地图上找到日本附近的公共吸烟区', description: '根据当前位置，在地图上找出日本附近的公共吸烟区及车站、商业设施的吸烟室。标注可吸卷烟或仅限加热烟。' },
  ko: { title: '흡연구역 찾기｜일본 내 주변 공공 흡연구역 지도', description: '현재 위치에서 가까운 일본의 공공 흡연구역과 역·상업시설 흡연실을 지도로 찾아보세요. 일반 담배 가능/가열식 전용 구분.' },
  de: { title: 'Raucherbereich-Finder: öffentliche Raucherbereiche in deiner Nähe in Japan', description: 'Finde die nächsten öffentlichen Raucherbereiche in Japan auf der Karte – mit Angabe, ob Zigaretten erlaubt sind oder nur Tabakerhitzer.' },
  fr: { title: 'Trouver un espace fumeurs : les espaces fumeurs publics près de vous au Japon', description: 'Trouvez sur une carte les espaces fumeurs publics les plus proches au Japon, avec la distinction cigarettes autorisées / tabac chauffé uniquement.' },
  it: { title: 'Trova aree fumatori: le aree fumatori pubbliche vicino a te in Giappone', description: 'Trova sulla mappa le aree fumatori pubbliche più vicine in Giappone, con l’indicazione sigarette consentite / solo tabacco riscaldato.' },
  es: { title: 'Buscador de zonas de fumadores: zonas públicas para fumar cerca de ti en Japón', description: 'Encuentra en el mapa las zonas públicas para fumar más cercanas en Japón, indicando si se permiten cigarrillos o solo tabaco calentado.' },
}[lang];
---

<!doctype html>
<html lang={getLocale(lang).hreflang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Analytics />
    {siteConfig.googleSiteVerification && <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />}
    <title>{meta.title} | {siteConfig.siteName}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={url(lang)} />
    {locales.map((l) => <link rel="alternate" hreflang={l.hreflang} href={url(l.code)} />)}
    <link rel="alternate" hreflang="x-default" href={url('en')} />
    <meta name="theme-color" content="#0f766e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href="/smoking/spots.json" as="fetch" crossorigin />
  </head>
  <body>
    <!-- Leaflet は window が必要なのでブラウザでだけ描画する -->
    <SmokingFinder client:only="react" pageLang={lang} />
    <ConsentBanner lang={lang} />
    <script>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
  </body>
</html>
