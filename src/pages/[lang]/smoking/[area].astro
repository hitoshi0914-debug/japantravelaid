---
// 地域ごとの喫煙所一覧（例: /en/smoking/tokyo-taito/）。spots.json から自動で作る。
// 検索流入（「台東区 喫煙所」など）の入口で、AdSense の広告はこのページに出る（地図画面には出さない）。
// 件数が少ない地域は noindex・サイトマップ外（MIN_INDEXABLE_SPOTS）。
import { langPaths, type Lang } from '../../../i18n/locales';
import Base from '../../../layouts/Base.astro';
import { areaName, cityName, contributionCounts, localized, spotLang, MIN_INDEXABLE_SPOTS, rankFor, reportUrl, routeUrl, type Spot } from '../../../lib/smoking';
import { loadSpots, spotAreas } from '../../../lib/smokingData';

export function getStaticPaths() {
  return langPaths().flatMap(({ params }) =>
    spotAreas().map((g) => ({ params: { lang: params.lang, area: g.area.slug }, props: g })),
  );
}

const { area, spots } = Astro.props;
const lang = Astro.params.lang as Lang;
const name = areaName(area, lang);
const updated = loadSpots().generated_at.slice(0, 10);
// 投稿者のランクは全国の投稿数で決める
const counts = contributionCounts(loadSpots().spots);
const indexable = spots.length >= MIN_INDEXABLE_SPOTS;

const n = spots.length;
const city = cityName(area, lang);
const L = {
  en: {
    title: `Smoking areas in ${name} (${n})`,
    description: `${n} public smoking areas in ${name}, Japan, with cigarette / heated-tobacco info, hours, map and walking directions.`,
    lead: 'Smoking on the street is banned in many areas of Japan, and fines may apply. Please use designated smoking areas and follow the signs on site, as details may change.',
    map: 'Show on map', route: 'Directions', report: 'Report closed / wrong info', hours: 'Hours',
    allAreas: 'Browse other areas', nearMe: 'Find smoking areas near me', updated: 'Data updated',
    types: { outdoor: 'Outdoor', booth: 'Booth', indoor: 'Indoor', unknown: 'Smoking area' },
    tobacco: { any: 'Cigarettes OK', heated_only: 'Heated tobacco only', unknown: 'Tobacco type unknown' },
    customers: 'Customers only', unnamed: 'Smoking area',
    addedBy: (x: string) => `Added by ${x}`,
    ranks: { bronze: '🥉 Bronze', silver: '🥈 Silver', gold: '🥇 Gold', platinum: '🏅 Platinum', diamond: '💎 Diamond' },
  },
  ja: {
    title: `${area.city}の喫煙所一覧（${n}か所）`,
    description: `${area.pref}${area.city}の公衆喫煙所・駅や商業施設の喫煙所 ${n} か所。紙巻きOK・加熱式のみの区別、利用時間、地図とルート案内つき。`,
    lead: '路上喫煙が禁止されている地域が多いので、指定の喫煙所をご利用ください。情報は変わることがあるため、現地の表示に従ってください。',
    map: '地図で見る', route: 'ルート案内', report: '閉鎖・間違いを報告', hours: '利用時間',
    allAreas: 'ほかの地域から探す', nearMe: '現在地から近い喫煙所を探す', updated: 'データ更新',
    types: { outdoor: '屋外', booth: 'ブース', indoor: '屋内', unknown: '喫煙所' },
    tobacco: { any: '紙巻きOK', heated_only: '加熱式のみ', unknown: '紙巻き/加熱式 不明' },
    customers: '利用者限定', unnamed: '喫煙所',
    addedBy: (x: string) => `${x} さんが追加`,
    ranks: { bronze: '🥉 ブロンズ', silver: '🥈 シルバー', gold: '🥇 ゴールド', platinum: '🏅 プラチナ', diamond: '💎 ダイヤ' },
