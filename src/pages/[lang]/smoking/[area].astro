  'zh-tw': {
    title: `${city}的吸菸區（${n} 處）`,
    description: `日本${area.pref}${area.city}的公共吸菸區及車站、商業設施吸菸室共 ${n} 處，附可吸紙菸／僅限加熱菸、開放時間、地圖與路線。`,
    lead: '日本許多地區禁止在路上吸菸，違者可能被罰款。請使用指定的吸菸區，資訊可能變更，請以現場標示為準。',
    map: '在地圖上查看', route: '路線導航', report: '回報已關閉／資訊有誤', hours: '開放時間',
    allAreas: '搜尋其他地區', nearMe: '搜尋我附近的吸菸區', updated: '資料更新',
    types: { outdoor: '戶外', booth: '吸菸室', indoor: '室內', unknown: '吸菸區' },
    tobacco: { any: '可吸紙菸', heated_only: '僅限加熱菸', unknown: '菸品類型不明' },
    customers: '限顧客使用', unnamed: '吸菸區',
    addedBy: (x: string) => `由 ${x} 新增`,
    ranks: { bronze: '🥉 銅牌', silver: '🥈 銀牌', gold: '🥇 金牌', platinum: '🏅 白金', diamond: '💎 鑽石' },
  },
  'zh-cn': {
    title: `${city}的吸烟区（${n} 处）`,
    description: `日本${area.pref}${area.city}的公共吸烟区及车站、商业设施吸烟室共 ${n} 处，附可吸卷烟／仅限加热烟、开放时间、地图与路线。`,
    lead: '日本许多地区禁止在路上吸烟，违者可能被罚款。请使用指定的吸烟区，信息可能变更，请以现场标识为准。',
    map: '在地图上查看', route: '路线导航', report: '报告已关闭／信息有误', hours: '开放时间',
    allAreas: '查找其他地区', nearMe: '查找我附近的吸烟区', updated: '数据更新',
    types: { outdoor: '户外', booth: '吸烟室', indoor: '室内', unknown: '吸烟区' },
    tobacco: { any: '可吸卷烟', heated_only: '仅限加热烟', unknown: '烟草类型不明' },
    customers: '仅限顾客', unnamed: '吸烟区',
    addedBy: (x: string) => `由 ${x} 添加`,
    ranks: { bronze: '🥉 铜牌', silver: '🥈 银牌', gold: '🥇 金牌', platinum: '🏅 白金', diamond: '💎 钻石' },
  },
  ko: {
    title: `${city} 흡연구역 (${n}곳)`,
    description: `일본 ${name}의 공공 흡연구역과 역·상업시설 흡연실 ${n}곳. 일반 담배 가능/가열식 전용 구분, 이용 시간, 지도와 길찾기 제공.`,
    lead: '일본의 많은 지역에서 길거리 흡연이 금지되어 있고 과태료가 부과될 수 있습니다. 지정된 흡연구역을 이용하시고, 정보가 바뀔 수 있으니 현장 안내를 따라 주세요.',
    map: '지도에서 보기', route: '길찾기', report: '폐쇄·정보 오류 신고', hours: '이용 시간',
    allAreas: '다른 지역 찾기', nearMe: '내 주변 흡연구역 찾기', updated: '데이터 갱신',
    types: { outdoor: '실외', booth: '부스', indoor: '실내', unknown: '흡연구역' },
    tobacco: { any: '일반 담배 가능', heated_only: '가열식 담배 전용', unknown: '담배 종류 불명' },
    customers: '이용객 전용', unnamed: '흡연구역',
    addedBy: (x: string) => `${x} 님이 추가`,
    ranks: { bronze: '🥉 브론즈', silver: '🥈 실버', gold: '🥇 골드', platinum: '🏅 플래티넘', diamond: '💎 다이아' },
  },
  de: {
    title: `Raucherbereiche in ${name} (${n})`,
    description: `${n} öffentliche Raucherbereiche in ${name}, Japan – mit Infos zu Zigaretten / Tabakerhitzern, Öffnungszeiten, Karte und Fußweg.`,
    lead: 'In vielen Gegenden Japans ist das Rauchen auf der Straße verboten, und es können Bußgelder drohen. Bitte nutze die ausgewiesenen Raucherbereiche und beachte die Hinweise vor Ort, da sich Angaben ändern können.',
    map: 'Auf der Karte zeigen', route: 'Route', report: 'Geschlossen / falsche Angaben melden', hours: 'Öffnungszeiten',
    allAreas: 'Andere Gegenden ansehen', nearMe: 'Raucherbereiche in meiner Nähe finden', updated: 'Daten aktualisiert',
    types: { outdoor: 'Im Freien', booth: 'Raucherkabine', indoor: 'Innenbereich', unknown: 'Raucherbereich' },
    tobacco: { any: 'Zigaretten erlaubt', heated_only: 'Nur Tabakerhitzer', unknown: 'Tabakart unbekannt' },
    customers: 'Nur für Kunden', unnamed: 'Raucherbereich',
    addedBy: (x: string) => `Hinzugefügt von ${x}`,
    ranks: { bronze: '🥉 Bronze', silver: '🥈 Silber', gold: '🥇 Gold', platinum: '🏅 Platin', diamond: '💎 Diamant' },
  },
  fr: {
    title: `Espaces fumeurs à ${name} (${n})`,
    description: `${n} espaces fumeurs publics à ${name}, Japon, avec infos cigarettes / tabac chauffé, horaires, carte et itinéraire à pied.`,
    lead: 'Fumer dans la rue est interdit dans de nombreux quartiers du Japon et peut être passible d’une amende. Utilisez les espaces fumeurs désignés et suivez les indications sur place, car les informations peuvent changer.',
    map: 'Voir sur la carte', route: 'Itinéraire', report: 'Signaler une fermeture / une erreur', hours: 'Horaires',
    allAreas: 'Voir d’autres quartiers', nearMe: 'Trouver un espace fumeurs près de moi', updated: 'Données mises à jour',
    types: { outdoor: 'En plein air', booth: 'Cabine', indoor: 'Intérieur', unknown: 'Espace fumeurs' },
    tobacco: { any: 'Cigarettes autorisées', heated_only: 'Tabac chauffé uniquement', unknown: 'Type de tabac inconnu' },
    customers: 'Réservé aux clients', unnamed: 'Espace fumeurs',
    addedBy: (x: string) => `Ajouté par ${x}`,
    ranks: { bronze: '🥉 Bronze', silver: '🥈 Argent', gold: '🥇 Or', platinum: '🏅 Platine', diamond: '💎 Diamant' },
  },
  it: {
    title: `Aree fumatori a ${name} (${n})`,
    description: `${n} aree fumatori pubbliche a ${name}, Giappone, con info su sigarette / tabacco riscaldato, orari, mappa e percorso a piedi.`,
    lead: 'In molte zone del Giappone è vietato fumare per strada e si rischiano multe. Utilizza le aree fumatori designate e segui le indicazioni sul posto, perché le informazioni possono cambiare.',
    map: 'Mostra sulla mappa', route: 'Indicazioni', report: 'Segnala chiusura / info errate', hours: 'Orari',
    allAreas: 'Sfoglia altre zone', nearMe: 'Trova aree fumatori vicino a me', updated: 'Dati aggiornati',
    types: { outdoor: 'All’aperto', booth: 'Cabina', indoor: 'Al chiuso', unknown: 'Area fumatori' },
    tobacco: { any: 'Sigarette consentite', heated_only: 'Solo tabacco riscaldato', unknown: 'Tipo di tabacco sconosciuto' },
    customers: 'Solo per clienti', unnamed: 'Area fumatori',
    addedBy: (x: string) => `Aggiunto da ${x}`,
    ranks: { bronze: '🥉 Bronzo', silver: '🥈 Argento', gold: '🥇 Oro', platinum: '🏅 Platino', diamond: '💎 Diamante' },
  },
  es: {
    title: `Zonas de fumadores en ${name} (${n})`,
    description: `${n} zonas públicas para fumar en ${name}, Japón, con información sobre cigarrillos / tabaco calentado, horarios, mapa y ruta a pie.`,
    lead: 'En muchas zonas de Japón está prohibido fumar en la calle y pueden imponerse multas. Usa las zonas de fumadores designadas y sigue las indicaciones del lugar, ya que la información puede cambiar.',
    map: 'Ver en el mapa', route: 'Cómo llegar', report: 'Informar de cierre / datos erróneos', hours: 'Horario',
    allAreas: 'Ver otras zonas', nearMe: 'Buscar zonas de fumadores cerca de mí', updated: 'Datos actualizados',
    types: { outdoor: 'Al aire libre', booth: 'Cabina', indoor: 'Interior', unknown: 'Zona de fumadores' },
    tobacco: { any: 'Se permiten cigarrillos', heated_only: 'Solo tabaco calentado', unknown: 'Tipo de tabaco desconocido' },
    customers: 'Solo clientes', unnamed: 'Zona de fumadores',
    addedBy: (x: string) => `Añadido por ${x}`,
    ranks: { bronze: '🥉 Bronce', silver: '🥈 Plata', gold: '🥇 Oro', platinum: '🏅 Platino', diamond: '💎 Diamante' },
  },
}[lang];
const spotName = (s: Spot) => localized(s.name, spotLang(lang)) ?? L.unnamed;
---

<Base lang={lang} title={L.title} description={L.description} path={`smoking/${area.slug}/`} backHref={`/${lang}/smoking/areas/`} noindex={!indexable}>
  <h1 class="page-title">🚬 {L.title}</h1>
  <p class="lead">{L.lead}</p>
  <a class="cta" href={`/${lang}/smoking/`}>📍 {L.nearMe}</a>

  <ol class="spots">
    {spots.map((s) => {
      const report = reportUrl(s.id);
      const address = localized(s.address, spotLang(lang));
      return (
        <li class="spot">
          <h2>{spotName(s)}</h2>
          {address && <p class="addr">{address}</p>}
          <p class="tags">
            <span>{L.types[s.type]}</span>
            <span class:list={['tob', `tob--${s.tobacco}`]}>{L.tobacco[s.tobacco]}</span>
            {s.access === 'customers' && <span class="cust">{L.customers}</span>}
            {s.hours && <span>🕒 {L.hours}: {s.hours}</span>}
          </p>
          {s.added_by && (() => {
            const rank = rankFor(counts.get(s.added_by) ?? 0);
            return <p class="by">{L.addedBy(s.added_by)} {rank && <span class:list={['rank', `rank--${rank}`]}>{L.ranks[rank]}</span>}</p>;
          })()}
          <p class="actions">
            <a href={`/${lang}/smoking/?spot=${encodeURIComponent(s.id)}`}>{L.map}</a>
            <a href={routeUrl(s)} target="_blank" rel="noopener" data-ga="smoking_route">{L.route}</a>
            {report && <a class="report" href={report} target="_blank" rel="noopener" data-ga="smoking_report">{L.report}</a>}
          </p>
        </li>
      );
    })}
  </ol>

  <p class="more"><a href={`/${lang}/smoking/areas/`}>{L.allAreas} →</a></p>
  <p class="credit">{L.updated}: {updated} · © OpenStreetMap contributors (ODbL) · Geolonia 住所データ (CC BY 4.0)</p>
</Base>

<style>
  .page-title { font-size: 1.35rem; margin: 8px 0 4px; }
  .lead { color: var(--muted); font-size: 0.88rem; }
  .cta { display: flex; align-items: center; justify-content: center; min-height: 52px; margin: 12px 0 16px; border-radius: var(--radius); background: #0f766e; color: #fff; font-weight: 800; text-decoration: none; }
  .spots { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .spot { padding: 12px 14px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); }
  .spot h2 { margin: 0; font-size: 1.02rem; }
  .addr { margin: 2px 0 0; font-size: 0.8rem; color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; font-size: 0.75rem; }
  .tags span { padding: 2px 8px; border-radius: 6px; background: var(--bg); }
  .tob--any { background: #ccfbf1 !important; color: #134e4a; }
  .tob--heated_only { background: #ede9fe !important; color: #4c1d95; }
  .cust { background: #fde68a !important; color: #451a03; font-weight: 700; }
  .actions { display: flex; flex-wrap: wrap; gap: 0 16px; margin: 0; font-size: 0.92rem; font-weight: 700; }
  .actions a { display: inline-flex; align-items: center; min-height: 44px; }
  .actions .report { font-weight: 400; font-size: 0.82rem; color: var(--muted); }
  .by { margin: -2px 0 8px; font-size: 0.75rem; color: var(--muted); }
  .rank { padding: 1px 7px; border-radius: 999px; font-weight: 700; font-size: 0.68rem; }
  .rank--bronze { background: #ffedd5; color: #9a3412; }
  .rank--silver { background: #e2e8f0; color: #334155; }
  .rank--gold { background: #fef9c3; color: #854d0e; }
  .rank--platinum { background: #cffafe; color: #155e75; }
  .rank--diamond { background: #ede9fe; color: #5b21b6; }
  .more { margin-top: 20px; font-weight: 700; }
  .more a { display: inline-flex; align-items: center; min-height: 48px; }
  .credit { font-size: 0.7rem; color: var(--muted); }
</style>
