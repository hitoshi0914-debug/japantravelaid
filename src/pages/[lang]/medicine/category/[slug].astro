---
// カテゴリページ（頭痛・風邪など）: 箱の言葉の早見表 ＋ 主な成分名の対訳 ＋ 指差しカードへの近道。
// 薬の推奨はしない。カタログ（src/data/medicines.ts）が埋まったら、ここに品目一覧を出す。
import { tiles } from '../../../../data/categories';
import { categoryInfo, commonWords } from '../../../../data/kanji';
import { medicines } from '../../../../data/medicines';
import { locales, tr, type Lang } from '../../../../i18n/locales';
import Base from '../../../../layouts/Base.astro';

export function getStaticPaths() {
  return locales.flatMap((l) =>
    tiles.filter((t) => t.kind === 'category').map((tile) => ({ params: { lang: l.code, slug: tile.id }, props: { tile } })),
  );
}

const { tile } = Astro.props;
const lang = Astro.params.lang as Lang;
const info = categoryInfo[tile.id];
const items = medicines.filter((m) => m.category === tile.id);
const cardLink = `/${lang}/medicine/pharmacist/?s=${(tile.symptoms ?? []).join(',')}`;

// 見出しと注記。ja のページでは言葉の意味は英語のまま（日本語↔英語の対訳表）。
// 「名前を訳すだけで、どの製品が合うかは示さない」の注記はどの言語でも必ず残す。
const C = {
  en: {
    cta: '🗣️ Ask the pharmacist with a card →', wordsH: 'Words on the box', ingrH: 'Common ingredient names',
    ingrNote: 'Names are shown in katakana on the box. This list only translates names; it does not say which product suits you.',
    productsH: 'Products', commonH: 'Words on every medicine box',
  },
  ja: {
    cta: '🗣️ カードで薬剤師に相談する →', wordsH: '箱に書いてある言葉', ingrH: '主な成分名',
    ingrNote: '箱では成分名がカタカナで書かれています。この表は名前を訳しているだけで、どの製品が合うかを示すものではありません。',
    productsH: '製品', commonH: 'どの薬の箱にも出てくる言葉',
  },
  'zh-tw': {
    cta: '🗣️ 用卡片詢問藥劑師 →', wordsH: '包裝上的字詞', ingrH: '常見成分名稱',
    ingrNote: '包裝上的成分名稱以片假名標示。此列表只翻譯名稱，並不表示哪種產品適合您。',
    productsH: '產品', commonH: '每種藥盒上都有的字詞',
  },
  'zh-cn': {
    cta: '🗣️ 用卡片询问药剂师 →', wordsH: '包装上的词语', ingrH: '常见成分名称',
    ingrNote: '包装上的成分名称以片假名标示。此列表只翻译名称，并不表示哪种产品适合您。',
    productsH: '产品', commonH: '每种药盒上都有的词语',
  },
  ko: {
    cta: '🗣️ 카드로 약사에게 물어보기 →', wordsH: '상자에 적힌 말', ingrH: '주요 성분 이름',
    ingrNote: '상자에는 성분 이름이 가타카나로 적혀 있습니다. 이 목록은 이름만 번역한 것이며, 어떤 제품이 맞는지는 알려주지 않습니다.',
    productsH: '제품', commonH: '모든 약 상자에 나오는 말',
  },
  de: {
    cta: '🗣️ Mit einer Karte den Apotheker fragen →', wordsH: 'Wörter auf der Packung', ingrH: 'Häufige Wirkstoffnamen',
    ingrNote: 'Auf der Packung stehen die Namen in Katakana. Diese Liste übersetzt nur Namen; sie sagt nicht, welches Produkt zu Ihnen passt.',
    productsH: 'Produkte', commonH: 'Wörter auf jeder Medikamentenpackung',
  },
  fr: {
    cta: '🗣️ Demander au pharmacien avec une carte →', wordsH: 'Mots sur la boîte', ingrH: 'Noms de substances courants',
    ingrNote: 'Sur la boîte, les noms sont écrits en katakana. Cette liste ne fait que traduire des noms ; elle n’indique pas quel produit vous convient.',
    productsH: 'Produits', commonH: 'Mots présents sur toutes les boîtes de médicaments',
  },
  it: {
    cta: '🗣️ Chiedi al farmacista con una scheda →', wordsH: 'Parole sulla confezione', ingrH: 'Nomi comuni dei principi attivi',
    ingrNote: 'Sulla confezione i nomi sono scritti in katakana. Questo elenco traduce solo i nomi; non indica quale prodotto sia adatto a te.',
    productsH: 'Prodotti', commonH: 'Parole presenti su ogni confezione di farmaco',
  },
  es: {
    cta: '🗣️ Preguntar al farmacéutico con una tarjeta →', wordsH: 'Palabras en la caja', ingrH: 'Nombres comunes de principios activos',
    ingrNote: 'En la caja, los nombres aparecen en katakana. Esta lista solo traduce nombres; no indica qué producto le conviene.',
    productsH: 'Productos', commonH: 'Palabras de todas las cajas de medicamentos',
  },
}[lang];
---

<Base lang={lang} title={tr(tile.label, lang)} description={tr(info.intro, lang)} path={`medicine/category/${tile.id}/`} backHref={`/${lang}/medicine/`}>
  <h1 class="page-title"><span aria-hidden="true">{tile.pictogram}</span> {tr(tile.label, lang)}</h1>
  <p class="lead">{tr(info.intro, lang)}</p>

  <a class="cta" href={cardLink} data-ga="category_to_card" data-ga-params={JSON.stringify({ category: tile.id })}>
    {C.cta}
  </a>

  <h2>{C.wordsH}</h2>
  <dl class="words">
    {info.words.map((w) => (
      <div><dt lang="ja">{w.ja}</dt><dd><span class="reading">{w.reading}</span>{tr(w.meaning, lang)}</dd></div>
    ))}
  </dl>

  <h2>{C.ingrH}</h2>
  <p class="note">{C.ingrNote}</p>
  <dl class="words">
    {info.ingredients.map((w) => (
      <div><dt lang="ja">{w.ja}</dt><dd><span class="reading">{w.reading}</span>{tr(w.meaning, lang)}</dd></div>
    ))}
  </dl>

  {items.length > 0 && (
    <>
      <h2>{C.productsH}</h2>
      <ul>{items.map((m) => <li>{m.name.en} <span lang="ja">{m.name.ja}</span></li>)}</ul>
    </>
  )}

  <details class="common">
    <summary>{C.commonH}</summary>
    <dl class="words">
      {commonWords.map((w) => (
        <div><dt lang="ja">{w.ja}</dt><dd><span class="reading">{w.reading}</span>{tr(w.meaning, lang)}</dd></div>
      ))}
    </dl>
  </details>
</Base>

<style>
  .page-title { font-size: 1.4rem; margin: 8px 0 4px; }
  .lead, .note { color: var(--muted); font-size: 0.9rem; }
  h2 { font-size: 1.1rem; margin: 24px 0 8px; }
  .cta {
    display: flex; align-items: center; justify-content: center;
    min-height: 56px; border-radius: var(--radius);
    background: var(--accent); color: #fff; font-weight: 800; text-decoration: none;
  }
  .words { display: grid; gap: 6px; margin: 0; }
  .words div { display: grid; grid-template-columns: 9.5em 1fr; gap: 8px; align-items: center; padding: 10px 12px; border-radius: 12px; background: var(--surface); border: 1px solid var(--border); }
  .words dt { font-size: 1.15rem; font-weight: 800; overflow-wrap: anywhere; }
  .words dd { margin: 0; font-size: 0.9rem; }
  .reading { display: block; font-size: 0.75rem; color: var(--muted); }
  .common { margin-top: 24px; }
  .common summary { min-height: var(--tap); display: flex; align-items: center; font-weight: 700; cursor: pointer; }
</style>
