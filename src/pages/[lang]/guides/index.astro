---
// 旅行ガイドの一覧（読み物）。いまは英語・日本語だけ（src/data/guides.ts の GUIDE_LANGS）。
import { Icon } from '../../../components/Icon';
import { GUIDE_LANGS, guides, guideUi, type GuideLang } from '../../../data/guides';
import { langPaths } from '../../../i18n/locales';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = () => langPaths(GUIDE_LANGS);
const lang = Astro.params.lang as GuideLang;
---

<Base lang={lang} title={guideUi.listTitle[lang]} description={guideUi.listDescription[lang]} path="guides/">
  <h1>{guideUi.listTitle[lang]}</h1>
  <p class="lead">{guideUi.listLead[lang]}</p>
  <ul class="guide-list">
    {guides.map((g) => (
      <li>
        <a href={`/${lang}/guides/${g.slug}/`}>
          <Icon name={g.icon} />
          <span><strong>{g.text[lang].title}</strong><small>{g.text[lang].description}</small></span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  h1 { font-size: 1.4rem; margin: 12px 0 8px; }
  .lead { color: var(--muted); }
  .guide-list { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 12px; }
  .guide-list a { display: flex; gap: 12px; align-items: flex-start; padding: 16px; min-height: 56px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); color: var(--text); text-decoration: none; }
  .guide-list span { display: grid; gap: 4px; }
  .guide-list small { color: var(--muted); font-size: 0.85rem; }
</style>
