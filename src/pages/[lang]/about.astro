---
// 運営者情報・免責事項（9言語）。市販薬ガイドの免責は日本語の正式文も必ず残す。
import { langPaths, tr, type Lang } from '../../i18n/locales';
import { ui } from '../../i18n/ui';
import Donate from '../../components/Donate.astro';
import Base from '../../layouts/Base.astro';
import { siteConfig } from '../../site.config';

export const getStaticPaths = () => langPaths();
const lang = Astro.params.lang as Lang;
const name = siteConfig.siteName;

const C = {
  en: {
    intro: `${name} is a set of simple tools for visitors to Japan: a smoking area finder and a drugstore & emergency guide. It is an independent site and is not affiliated with any pharmaceutical company, drugstore, tobacco company or government body.`,
    smokingH: 'Smoking area finder',
    smoking: [
      'Smoking area data comes from OpenStreetMap contributors (ODbL), municipal open data and posts from users that we check before publishing. It may be incomplete or out of date.',
      'Rules differ by area and may change. Always follow the signs on site.',
      'Restaurants, bars and cafés that allow smoking are not listed.',
    ],
    medH: 'Medicine guide: not medical advice',
    med: [
      'This site does not diagnose, prescribe or recommend any medicine.',
      'Product and ingredient information is a translation of publicly available package-insert information. It may be incomplete or out of date.',
      'Always ask a pharmacist, registered seller or doctor before buying or taking medicine, and follow the package insert.',
      'In an emergency, call 119.',
    ],
    contact: 'Contact',
  },
  ja: {
    intro: `${name} は、訪日旅行者向けのシンプルなツール集です（喫煙所ファインダー、ドラッグストア・救急ガイド）。個人が運営する独立したサイトで、製薬会社・ドラッグストア・たばこ会社・行政機関とは関係ありません。`,
    smokingH: '喫煙所ファインダー',
    smoking: [
      '喫煙所のデータは OpenStreetMap の協力者（ODbL）、自治体のオープンデータ、確認済みの利用者からの投稿をもとにしています。内容が不完全・古い場合があります。',
      'ルールは地域によって違い、変わることがあります。必ず現地の表示に従ってください。',
      '喫煙できる飲食店は掲載していません。',
    ],
    medH: '市販薬ガイド（医療行為ではありません）',
    med: [
      '本サイトは診断・処方・医薬品の推奨を行いません。',
      '製品・成分の情報は、添付文書等の公知情報の翻訳です。不完全・古い場合があります。',
      '医薬品の購入・使用は、必ず薬剤師・登録販売者・医師にご相談のうえ、添付文書に従ってください。',
      '緊急時は 119 に電話してください。',
    ],
    contact: '連絡先',
  },
  'zh-tw': {
    intro: `${name} 是為訪日旅客提供的簡單工具集：吸菸區搜尋，以及藥妝店與急救指南。本站為獨立網站，與任何製藥公司、藥妝店、菸草公司或政府機關無關。`,
    smokingH: '吸菸區搜尋',
    smoking: [
      '吸菸區資料來自 OpenStreetMap 貢獻者（ODbL）、地方政府開放資料，以及經我們確認後刊登的使用者投稿，可能不完整或已過時。',
      '各地規定不同且可能變更，請務必遵守現場標示。',
      '可吸菸的餐廳、酒吧、咖啡廳不在刊登範圍內。',
    ],
    medH: '藥品指南：並非醫療建議',
    med: [
      '本站不提供診斷、處方或任何藥品推薦。',
      '產品與成分資訊翻譯自公開的藥品說明書，可能不完整或已過時。',
      '購買或服用藥品前，請務必諮詢藥劑師、登錄販賣者或醫師，並遵照說明書。',
      '緊急情況請撥打 119。',
    ],
    contact: '聯絡方式',
  },
  'zh-cn': {
    intro: `${name} 是为访日游客提供的简单工具集：吸烟区查找，以及药妆店与急救指南。本站为独立网站，与任何制药公司、药妆店、烟草公司或政府机关无关。`,
    smokingH: '吸烟区查找',
    smoking: [
      '吸烟区数据来自 OpenStreetMap 贡献者（ODbL）、地方政府开放数据，以及经我们确认后发布的用户投稿，可能不完整或已过时。',
      '各地规定不同且可能变更，请务必遵守现场标识。',
      '可吸烟的餐厅、酒吧、咖啡馆不在收录范围内。',
    ],
    medH: '药品指南：并非医疗建议',
    med: [
      '本站不提供诊断、处方或任何药品推荐。',
      '产品与成分信息翻译自公开的药品说明书，可能不完整或已过时。',
      '购买或服用药品前，请务必咨询药剂师、登录销售者或医生，并遵照说明书。',
      '紧急情况请拨打 119。',
    ],
    contact: '联系方式',
  },
  ko: {
    intro: `${name}는 일본을 찾는 여행자를 위한 간단한 도구 모음입니다(흡연구역 찾기, 드러그스토어·응급 가이드). 개인이 운영하는 독립 사이트이며, 제약회사·드러그스토어·담배회사·행정기관과 관계가 없습니다.`,
    smokingH: '흡연구역 찾기',
    smoking: [
      '흡연구역 데이터는 OpenStreetMap 기여자(ODbL), 지자체 공개 데이터, 확인을 거친 이용자 제보를 바탕으로 합니다. 불완전하거나 오래된 정보일 수 있습니다.',
      '규칙은 지역마다 다르고 바뀔 수 있습니다. 반드시 현장 안내를 따르세요.',
      '흡연 가능한 음식점·바·카페는 싣지 않습니다.',
    ],
    medH: '의약품 가이드: 의료 조언이 아닙니다',
    med: [
      '이 사이트는 진단·처방·의약품 추천을 하지 않습니다.',
      '제품·성분 정보는 공개된 첨부 문서를 번역한 것으로, 불완전하거나 오래되었을 수 있습니다.',
      '의약품을 사거나 복용하기 전에 반드시 약사·등록판매자·의사와 상담하고 첨부 문서를 따르세요.',
      '응급 상황에서는 119에 전화하세요.',
    ],
    contact: '연락처',
  },
  de: {
    intro: `${name} ist eine Sammlung einfacher Tools für Japan-Reisende: eine Suche nach Raucherbereichen und ein Drogerie- und Notfall-Ratgeber. Die Website ist unabhängig und steht in keiner Verbindung zu Pharmaunternehmen, Drogerien, Tabakunternehmen oder Behörden.`,
    smokingH: 'Raucherbereich-Suche',
    smoking: [
      'Die Daten zu Raucherbereichen stammen von den Mitwirkenden von OpenStreetMap (ODbL), aus offenen Daten der Kommunen sowie aus Beiträgen von Nutzern, die wir vor der Veröffentlichung prüfen. Sie können unvollständig oder veraltet sein.',
      'Die Regeln unterscheiden sich je nach Gegend und können sich ändern. Beachten Sie immer die Schilder vor Ort.',
      'Restaurants, Bars und Cafés, in denen geraucht werden darf, werden nicht aufgeführt.',
    ],
    medH: 'Medikamenten-Ratgeber: keine medizinische Beratung',
    med: [
      'Diese Website stellt keine Diagnosen, verschreibt nichts und empfiehlt keine Medikamente.',
      'Die Angaben zu Produkten und Wirkstoffen sind Übersetzungen öffentlich zugänglicher Informationen aus Packungsbeilagen. Sie können unvollständig oder veraltet sein.',
      'Fragen Sie vor dem Kauf oder der Einnahme von Medikamenten immer einen Apotheker, einen registrierten Verkäufer (Tōroku hanbaisha) oder einen Arzt und befolgen Sie die Packungsbeilage.',
      'Rufen Sie im Notfall die 119 an.',
    ],
    contact: 'Kontakt',
  },
  fr: {
    intro: `${name} est un ensemble d'outils simples pour les visiteurs au Japon : un localisateur d'espaces fumeurs et un guide des pharmacies et des urgences. C'est un site indépendant, sans lien avec aucun laboratoire pharmaceutique, aucune pharmacie, aucun fabricant de tabac ni aucun organisme public.`,
    smokingH: "Localisateur d'espaces fumeurs",
    smoking: [
      "Les données sur les espaces fumeurs proviennent des contributeurs d'OpenStreetMap (ODbL), des données ouvertes des municipalités et de contributions d'utilisateurs que nous vérifions avant publication. Elles peuvent être incomplètes ou obsolètes.",
      'Les règles varient selon les endroits et peuvent changer. Respectez toujours la signalisation sur place.',
      'Les restaurants, bars et cafés où il est permis de fumer ne sont pas répertoriés.',
    ],
    medH: "Guide des médicaments : ceci n'est pas un avis médical",
    med: [
      "Ce site ne pose aucun diagnostic, ne prescrit et ne recommande aucun médicament.",
      'Les informations sur les produits et les principes actifs sont une traduction des informations publiques figurant dans les notices. Elles peuvent être incomplètes ou obsolètes.',
      "Demandez toujours conseil à un pharmacien, à un vendeur agréé (tōroku hanbaisha) ou à un médecin avant d'acheter ou de prendre un médicament, et suivez la notice.",
      'En cas d\'urgence, appelez le 119.',
    ],
    contact: 'Contact',
  },
  it: {
    intro: `${name} è una raccolta di strumenti semplici per chi visita il Giappone: una ricerca delle aree fumatori e una guida a farmacie ed emergenze. È un sito indipendente, non affiliato ad aziende farmaceutiche, farmacie, produttori di tabacco o enti pubblici.`,
    smokingH: 'Ricerca aree fumatori',
    smoking: [
      "I dati sulle aree fumatori provengono dai contributori di OpenStreetMap (ODbL), dai dati aperti dei comuni e da segnalazioni degli utenti che verifichiamo prima di pubblicarle. Possono essere incompleti o non aggiornati.",
      'Le regole variano da zona a zona e possono cambiare. Rispetta sempre la segnaletica sul posto.',
      'Ristoranti, bar e caffè in cui è consentito fumare non sono elencati.',
    ],
    medH: 'Guida ai farmaci: non è un consiglio medico',
    med: [
      'Questo sito non fa diagnosi, non prescrive e non consiglia alcun farmaco.',
      'Le informazioni su prodotti e principi attivi sono una traduzione delle informazioni pubbliche dei foglietti illustrativi. Possono essere incomplete o non aggiornate.',
      "Prima di acquistare o assumere un farmaco chiedi sempre a un farmacista, a un venditore abilitato (tōroku hanbaisha) o a un medico, e segui il foglietto illustrativo.",
      'In caso di emergenza chiama il 119.',
    ],
    contact: 'Contatti',
  },
  es: {
    intro: `${name} es un conjunto de herramientas sencillas para quienes visitan Japón: un buscador de zonas para fumar y una guía de farmacias y emergencias. Es un sitio independiente y no está vinculado a ninguna farmacéutica, farmacia, tabacalera ni organismo público.`,
    smokingH: 'Buscador de zonas para fumar',
    smoking: [
      'Los datos de las zonas para fumar proceden de los colaboradores de OpenStreetMap (ODbL), de datos abiertos municipales y de aportaciones de usuarios que revisamos antes de publicarlas. Pueden estar incompletos o desactualizados.',
      'Las normas varían según la zona y pueden cambiar. Respeta siempre la señalización del lugar.',
      'No se incluyen restaurantes, bares ni cafeterías donde se permite fumar.',
    ],
    medH: 'Guía de medicamentos: no es consejo médico',
    med: [
      'Este sitio no diagnostica, no receta ni recomienda ningún medicamento.',
      'La información sobre productos y principios activos es una traducción de la información pública de los prospectos. Puede estar incompleta o desactualizada.',
      'Antes de comprar o tomar un medicamento, consulta siempre a un farmacéutico, a un vendedor registrado (tōroku hanbaisha) o a un médico, y sigue el prospecto.',
      'En caso de emergencia, llama al 119.',
    ],
    contact: 'Contacto',
  },
}[lang];
const title = tr(ui.about, lang);
---

<Base lang={lang} title={title} path="about/">
  <h1>{title}</h1>
  <p>{C.intro}</p>

  <h2>{C.smokingH}</h2>
  <ul>{C.smoking.map((t) => <li>{t}</li>)}</ul>

  <h2>{C.medH}</h2>
  <ul>{C.med.map((t) => <li>{t}</li>)}</ul>

  {lang !== 'ja' && (
    <>
      <h2 lang="ja">免責事項</h2>
      <p lang="ja">本サイトは訪日外国人が薬局・ドラッグストアで薬剤師・登録販売者に相談するためのコミュニケーション補助ツールです。診断・処方・医薬品の推奨は行いません。掲載情報は添付文書等の公知情報の翻訳であり、正確性・最新性を保証しません。医薬品の購入・使用は必ず薬剤師・登録販売者・医師の判断に従ってください。</p>
    </>
  )}

  <Donate lang={lang} />

  {siteConfig.contactFormUrl && <p><a class="contact-btn" href={siteConfig.contactFormUrl.replace('PAGE', encodeURIComponent(`${lang}/about/`))} target="_blank" rel="noopener" data-ga="contact_click">✉️ {tr(ui.contact, lang)}</a></p>}
  {siteConfig.contactEmail && <p>{C.contact}: <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></p>}
</Base>
