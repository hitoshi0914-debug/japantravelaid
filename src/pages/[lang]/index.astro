---
// サイトのトップ: 緊急帯（レイアウト）＋ ツールの大きなアイコン。ツールが増えたら src/data/tools.ts に足す。
import HowToUse from '../../components/HowToUse.astro';
import { Icon } from '../../components/Icon';
import InstallHint from '../../components/InstallHint.astro';
import Tile from '../../components/Tile.astro';
import { tools } from '../../data/tools';
import { langPaths, tr, type Lang } from '../../i18n/locales';
import { ui } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => langPaths();
const lang = Astro.params.lang as Lang;
// 医療・救急（赤系）と日常（青系）に分けて並べる（2026-10-27 外部の UI 評価: 緊急性の高いものを見分けやすく）
const main = tools.filter((t) => !t.secondary);
// 喫煙所は「飲食・美容・交通」の中に小さく出す（2026-11-18 ユーザーの SEO 改善リスト。カードの下に小さく、は従来どおり）
const groups = [
  { title: ui.groupHealth, items: main.filter((t) => t.tone !== 'daily'), note: ui.healthNote, more: [] as typeof tools },
  { title: ui.groupDaily, items: main.filter((t) => t.tone === 'daily'), note: undefined, more: tools.filter((t) => t.secondary) },
];
---

<Base lang={lang} title={tr(ui.topTitle, lang)} description={tr(ui.siteTagline, lang)} path="">
  <h1 class="top-h1">{tr(ui.topH1, lang)}</h1>
  <p class="tagline">{tr(ui.siteTagline, lang)}</p>
  <InstallHint lang={lang} />
  <HowToUse lang={lang} />
  {groups.map((g) => (
    <section class="tool-group">
      <h2>{tr(g.title, lang)}</h2>
      <nav class="tools" aria-label={tr(g.title, lang)}>
        {g.items.map((tool) => <Tile tile={tool} lang={lang} />)}
      </nav>
      {g.note && <p class="group-note">{tr(g.note, lang)}</p>}
      {/* 喫煙所はカードの下に小さく（2026-10-09 ユーザー決定: サイトの中心は指差しカード） */}
      {g.more.length > 0 && (
        <ul class="more-tools">
          {g.more.map((t) => (
            <li><a href={`/${lang}/${t.path}`} data-ga="tile_click" data-ga-params={JSON.stringify({ tile: t.id })}><Icon name={t.icon} /> <span>{tr(t.label, lang)}</span><small>{tr(t.hint, lang)}</small></a></li>
          ))}
        </ul>
      )}
    </section>
  ))}
</Base>

<style>
  .top-h1 { margin: 12px 0 4px; font-size: 1.2rem; font-weight: 900; line-height: 1.3; }
  .group-note { margin: 10px 0 0; padding: 10px 12px; border-radius: var(--radius); background: var(--medical-soft); font-size: 0.85rem; line-height: 1.45; }
  .tagline { margin: 4px 0 16px; color: var(--muted); font-size: 0.9rem; }
  .tool-group h2 { margin: 20px 0 8px; font-size: 0.85rem; font-weight: 800; letter-spacing: 0.04em; color: var(--muted); text-transform: uppercase; }
  .tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .more-tools { list-style: none; margin: 12px 0 0; padding: 0; }
  .more-tools a { display: flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 16px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); color: var(--text); font-weight: 700; text-decoration: none; }
  .more-tools small { margin-left: auto; font-weight: 400; font-size: 0.8rem; color: var(--muted); }
</style>
